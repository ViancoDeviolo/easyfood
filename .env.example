# Copie este arquivo para .env e ajuste os valores.
#   cp .env.example .env        (Windows: copy .env.example .env)

PORT=3000

# "oracle" (padrão) ou "memory" (demonstração sem banco; dados somem ao reiniciar)
DB_CLIENT=oracle

# Autenticação: use uma chave longa e aleatória (mínimo 16 caracteres)
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=1d

# Fotos dos restaurantes: pasta local (em produção seria um Object Storage)
STORAGE_DIR=storage
IMAGE_MAX_MB=15

# Oracle local (docker compose up -d oracle)
ORACLE_USER=easyfood
ORACLE_PASSWORD=EasyFood_2026
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10

# Senha do SYS/SYSTEM do container (usada só pelo docker-compose)
ORACLE_ADMIN_PASSWORD=EasyFoodAdmin_2026

# Oracle Autonomous Database (OCI) — preencha só se for usar a nuvem com wallet
# ORACLE_CONNECT_STRING=easyfood_high
# ORACLE_WALLET_DIR=C:/oracle/wallet_easyfood
# ORACLE_WALLET_PASSWORD=senha-da-wallet
